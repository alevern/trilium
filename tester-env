    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(255) NOT NULL,
    industry VARCHAR(100),
    plan_tier VARCHAR(20) CHECK (plan_tier IN ("free", "starter", "pro", "enterprise")),
