# Usage: ./tester-env <command> [--port <port>] [--run-id <id>]
# Commands: deploy, reset, stop, logs, status, seed, verify, help

RUN_ID="default"
PORT="38080"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

refresh_names() {
    local suffix=""
    if [[ "${RUN_ID}" != "default" ]]; then
        suffix="-${RUN_ID}"
    fi
    CONTAINER_NAME="tester-env-trilium${suffix}"
    # IMAGE_TAG set by scripts/rl-env to a content-addressed tag so identical
    # (baseline, patch-set) combos share an image. Manual invocations get :dev.
    IMAGE_NAME="${IMAGE_TAG:-tester-env-trilium:dev}"
    DATA_VOLUME="trilium-data${suffix}"
    API_BASE="http://localhost:${PORT}/etapi"
}

###############################################################################
# ETAPI helper — deterministic note creation via Trilium's External API
# All noteIds are explicitly set, and all dates are fixed so the seed is
# fully reproducible across resets.
###############################################################################

API_BASE="http://localhost:${PORT}/etapi"
FIXED_UTC="2024-06-15 10:00:00.000Z"
FIXED_LOCAL="2024-06-15 11:00:00.000+0100"

etapi_create() {
    # Usage: etapi_create <noteId> <parentNoteId> <title> <type> <content> [mime] [notePosition] [prefix]
    local noteId="$1" parentNoteId="$2" title="$3" type="$4" content="$5"
    local mime="${6:-text/html}"
    local notePosition="${7:-10}"
    local prefix="${8:-}"

    local body
    body=$(jq -n \
        --arg noteId "$noteId" \
        --arg parent "$parentNoteId" \
        --arg title "$title" \
        --arg type "$type" \
        --arg mime "$mime" \
        --arg content "$content" \
        --arg pos "$notePosition" \
        --arg dc "$FIXED_LOCAL" \
        --arg udc "$FIXED_UTC" \
        '{
            noteId: $noteId,
            parentNoteId: $parent,
            title: $title,
            type: $type,
            mime: $mime,
            content: $content,
            notePosition: ($pos | tonumber),
            dateCreated: $dc,
            utcDateCreated: $udc
        }')

    local resp
    resp=$(curl -s -X POST "${API_BASE}/create-note" \
        -H "Content-Type: application/json" \
        -d "$body")
    local createdId
    createdId=$(echo "$resp" | jq -r '.note.noteId // empty')
    if [[ "$createdId" != "$noteId" ]]; then
        echo "ERROR: Failed to create note ${noteId}, got: ${resp}" >&2
        return 1
    fi
    echo "  + ${noteId}: ${title} (type=${type})"
}

etapi_set_content() {
    local noteId="$1" content="$2"
    curl -s -o /dev/null -X PUT "${API_BASE}/notes/${noteId}/content" \
        -H "Content-Type: text/plain" \
        -d "$content"
}

etapi_add_label() {
    # Usage: etapi_add_label <noteId> <name> <value> [isInheritable]
    local noteId="$1" name="$2" value="$3"
    local inheritable="${4:-false}"
    local resp
    resp=$(curl -s -X POST "${API_BASE}/attributes" \
        -H "Content-Type: application/json" \
        -d "$(jq -n --arg nid "$noteId" --arg name "$name" --arg val "$value" --arg inh "$inheritable" '{
            noteId: $nid,
            type: "label",
            name: $name,
            value: $val,
            isInheritable: ($inh == "true")
        }')")
    local aid
    aid=$(echo "$resp" | jq -r '.attributeId // empty')
    if [[ -z "$aid" ]]; then
        echo "WARN: Failed to add label ${name}=${value} to ${noteId}: ${resp}" >&2
    fi
}

