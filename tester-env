###############################################################################
# cmd_verify — check that seeded notes are present and have expected content
###############################################################################

cmd_verify() {
    echo "==> Verifying seed data..."
    local errors=0

    check_note_exists() {
        local noteId="$1" label="$2"
        local resp title
        resp=$(curl -s "${API_BASE}/notes/${noteId}")
        title=$(echo "$resp" | jq -r '.title // empty')
        if [[ "$title" == "$label" ]]; then
            echo "  ✓ ${noteId}: ${label}"
        else
            echo "  ✗ ${noteId}: expected '${label}' but got '${title}' (resp: ${resp})"
            errors=$((errors + 1))
        fi
    }

    check_note_content() {
        local noteId="$1" searchPhrase="$2" label="$3"
        local resp
        resp=$(curl -s "${API_BASE}/notes/${noteId}/content")
        if echo "$resp" | grep -qF "$searchPhrase"; then
            echo "  ✓ ${noteId} content contains '${label}'"
        else
            echo "  ✗ ${noteId} content missing '${searchPhrase}'"
            errors=$((errors + 1))
        fi
    }

    check_search_result() {
        local searchTerm="$1" expectedNoteId="$2" label="$3"
        local resp results found
        resp=$(curl -s "${API_BASE}/notes?search=${searchTerm}")
        results=$(echo "$resp" | jq -r '.results')
        found=$(echo "$results" | jq -r "map(.noteId) | join(\",\")")
        if echo "$found" | grep -q "$expectedNoteId"; then
            echo "  ✓ search '${searchTerm}' found ${expectedNoteId}"
        else
            echo "  ✗ search '${searchTerm}' did not find ${expectedNoteId} (found: ${found})"
            errors=$((errors + 1))
        fi
    }

    check_attribute() {
        local noteId="$1" attrName="$2" attrValue="$3"
        local resp attrId
        resp=$(curl -s "${API_BASE}/notes/${noteId}")
        local match
        match=$(echo "$resp" | jq -r ".attributes[] | select(.name == \"${attrName}\" and .value == \"${attrValue}\") | .attributeId // empty")
        if [[ -n "$match" ]]; then
            echo "  ✓ ${noteId} has label ${attrName}=${attrValue}"
        else
            echo "  ✗ ${noteId} missing label ${attrName}=${attrValue}"
            errors=$((errors + 1))
        fi
    }

    # Root book exists
    check_note_exists "acmeRoot" "ACME Corp Knowledge Base"

    # Section books exist
    check_note_exists "sectGettingStarted" "Getting Started"
    check_note_exists "sectProjectPlanning" "Project Planning"
    check_note_exists "sectMeetingNotes" "Meeting Notes"
    check_note_exists "sectTechnicalDocs" "Technical Documentation"
    check_note_exists "sectEngStandards" "Engineering Standards"
    check_note_exists "sectHRAdmin" "HR & Admin"

    # Key text notes with content checks
    check_note_content "noteWelcome" "ACME Corporation" "Welcome text"
    check_note_content "noteCodeOfConduct" "harassment-free" "Code of Conduct"
    check_note_content "noteITOnboarding" "helpdesk@acmecorp.com" "IT Onboarding"
    check_note_content "noteQ2Roadmap" "Dashboard v2" "Q2 Roadmap"
    check_note_content "noteBudgetReview" "Budget Review" "Budget Review"
    check_note_content "noteSprintPlanning" "Sprint Planning" "Sprint Planning"
    check_note_content "noteAllHands" "Jane Smith" "All Hands"
    check_note_content "noteCodeReview" "Code Review" "Code Review"
    check_note_content "noteGitWorkflow" "trunk-based" "Git Workflow"
    check_note_content "noteTeamDirectory" "Alice Chen" "Team Directory"

    # Code notes
    check_note_content "noteRollbackProc" "#!/bin/bash" "Rollback script"
    check_note_content "noteAuthEndpoints" "POST /api/v1/auth/login" "Auth endpoints"
    check_note_content "noteUserEndpoints" "GET /api/v1/users" "User endpoints"
    check_note_content "noteDBSchema" "CREATE TABLE organizations" "DB schema"
    check_note_content "noteDeployRunbook" "ECS service" "Deploy runbook"

    # Hierarchy: check children of acmeRoot
    local children
    children=$(curl -s "${API_BASE}/notes/acmeRoot" | jq -r '.childNoteIds | join(",")')
    for expected in sectGettingStarted sectProjectPlanning sectMeetingNotes sectTechnicalDocs sectEngStandards sectHRAdmin; do
        if echo "$children" | grep -q "$expected"; then
            echo "  ✓ acmeRoot child contains ${expected}"
        else
            echo "  ✗ acmeRoot missing child ${expected}"
            errors=$((errors + 1))
        fi
    done

    # Attributes
    check_attribute "noteITOnboarding" "priority" "high"
    check_attribute "noteITOnboarding" "department" "IT"
    check_attribute "noteBudgetReview" "status" "reviewed"
    check_attribute "noteQ2Retro" "type" "retrospective"
    check_attribute "noteQ2Retro" "quarter" "Q2"
    check_attribute "noteDeployRunbook" "environment" "production"

    # Search for unique phrase
    check_search_result "Q2%20Retrospective" "noteQ2Retro" "Q2 Retrospective search"

    # Q2 Retrospective specific content
    check_note_content "noteQ2Retro" "Q2 Retrospective" "Q2 Retro article"

    echo ""
    if [[ $errors -eq 0 ]]; then
        echo "==> Verify: PASS — all checks passed."
        return 0
    else
        echo "==> Verify: FAIL — ${errors} check(s) failed."
        return 1
    fi
}

###############################################################################
# Existing commands: deploy, reset, stop, logs, status, help
###############################################################################

cmd_deploy() {
    echo "==> Building Docker image from source (this may take several minutes)..."
    docker build -f "${SCRIPT_DIR}/Dockerfile.tester-env" -t "${IMAGE_NAME}" "${SCRIPT_DIR}"

    echo "==> Starting container on port ${PORT}..."
    docker run -d --name "${CONTAINER_NAME}" \
        -p "${PORT}:8080" \
        -v "${DATA_VOLUME}:/home/node/trilium-data" \
        -e TRILIUM_GENERAL_NOAUTHENTICATION=true \
        "${IMAGE_NAME}"

    echo "==> Waiting for server to start..."
    for i in $(seq 1 30); do
        if curl -s -o /dev/null "http://localhost:${PORT}/" 2>/dev/null; then
            echo "==> Server responding."
            break
        fi
        sleep 2
    done

    echo "==> Initializing database (no-auth mode)..."
    curl -s -X POST "http://localhost:${PORT}/api/setup/new-document" || true

    echo "==> Deployment complete. App running at http://localhost:${PORT}"
    echo "    Credentials: none (TRILIUM_GENERAL_NOAUTHENTICATION=true)"
    echo "    Data volume: ${DATA_VOLUME}"
}

cmd_reset() {
    echo "==> Resetting environment..."
    docker stop "${CONTAINER_NAME}" 2>/dev/null || true
    docker rm "${CONTAINER_NAME}" 2>/dev/null || true
    docker volume rm "${DATA_VOLUME}" 2>/dev/null || true
    echo "==> Reset complete. Run 'deploy' to start fresh."
}

cmd_stop() {
    echo "==> Stopping container..."
    docker stop "${CONTAINER_NAME}" 2>/dev/null || true
    echo "==> Stopped."
}

cmd_logs() {
    docker logs -f "${CONTAINER_NAME}" 2>/dev/null || echo "Container not running."
}

cmd_status() {
    if docker ps --filter "name=${CONTAINER_NAME}" --format "{{.Names}}" | grep -q "${CONTAINER_NAME}"; then
        echo "Status: RUNNING"
        echo "URL: http://localhost:${PORT}"
        echo "Container: ${CONTAINER_NAME}"
        echo "Volume: ${DATA_VOLUME}"
        echo "Credentials: none (no-auth mode)"
    else
        echo "Status: NOT RUNNING"
    fi
}

cmd_help() {
    cat <<EOF
Trilium - Tester Environment CLI

Usage: ./tester-env <command> [--port <port>] [--run-id <id>]

Commands:
  deploy    Build Docker image from source, start container, initialize DB
  seed      Populate with deterministic ACME Corp knowledge base (24+ notes)
  verify    Assert that seed data is present and searchable
  reset     Stop container, remove container and data volume
  stop      Stop container (preserves data)
  logs      Tail container logs
  status    Show container status and URL
  help      Show this help message

Options:
  --port <port>     Host port to bind to container port 8080.
                    Default: 38080
  --run-id <id>     Isolate container, image, and volume names for parallel runs.
                    Default: default

Seed data:
  Creates an ACME Corp knowledge base with 6 sections and 24+ notes:
    Getting Started · Project Planning · Meeting Notes
    Technical Documentation · Engineering Standards · HR & Admin

  Includes text notes, code notes with syntax highlighting,
  labels/attributes, and a searchable marker phrase "Q2 Retrospective".

Environment:
  TRILIUM_GENERAL_NOAUTHENTICATION=true  (set automatically by deploy)
  TRILIUM_DATA_DIR=/home/node/trilium-data

Credentials: none — no-auth mode enabled, no login required.

Typical workflow:
  ./tester-env deploy    # Build from source, start container, init DB
  ./tester-env seed      # Populate with deterministic seed data
  ./tester-env verify    # Check seed data integrity
  ./tester-env reset     # Clean slate

Dockerfile: Dockerfile.tester-env (multi-stage, builds entire monorepo from source)
Port: 8080 (container) → 38080 (host default)
Data: /home/node/trilium-data (container) → named volume 'trilium-data'
EOF
}

main() {
    local cmd="${1:-help}"

    # Parse optional arguments
    for ((i=2; i<=$#; i++)); do
        local arg="${!i}"
        case "${arg}" in
            --port)
                local next=$((i+1))
                if [[ ${next} -le $# ]]; then
                    PORT="${!next}"
                    ((i++))
                else
                    echo "Error: --port requires a value"
                    exit 1
                fi
                ;;
            --run-id)
                local next=$((i+1))
                if [[ ${next} -le $# ]]; then
                    RUN_ID="${!next}"
                    ((i++))
                else
                    echo "Error: --run-id requires a value"
                    exit 1
                fi
                ;;
            --help|-h)
                cmd_help
                exit 0
                ;;
            *)
                echo "Unknown option: ${arg}"
                cmd_help
                exit 1
                ;;
        esac
    done

    refresh_names

    case "${cmd}" in
        deploy)     cmd_deploy ;;
        seed)       cmd_seed ;;
        verify)     cmd_verify ;;
        reset)      cmd_reset ;;
        stop)       cmd_stop ;;
        logs)       cmd_logs ;;
        status)     cmd_status ;;
        help|--help|-h) cmd_help ;;
        *)
            echo "Unknown command: ${cmd}"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
